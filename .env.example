# Supabase — captura de leads de la lista de espera.
# Copia este archivo a `.env` y rellena los valores del proyecto.
# En Vercel, agrega estas dos variables en Settings -> Environment Variables.
#
# Deben llevar el prefijo PUBLIC_ para que Astro las exponga al navegador.
# La anon key es publica por diseno: la proteccion real esta en las RLS
# policies definidas en supabase/migrations/0001_waitlist_lead.sql
# (solo permite INSERT anonimo, nunca SELECT).

PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# WhatsApp de ventas: es el canal donde se cierra la renta.
# Solo digitos, con codigo de pais, sin + ni espacios. Ej: 584121234567
# Si se deja vacio, la landing esconde los botones de WhatsApp
# (nunca enlaza a un numero inventado).
PUBLIC_WHATSAPP=
