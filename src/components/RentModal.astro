<style>
  @keyframes hot-deal-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(255, 107, 44, 0.6);
    }
    50% {
      transform: scale(1.06);
      box-shadow: 0 0 12px 3px rgba(255, 107, 44, 0.45);
    }
  }

  .hot-deal-badge {
    animation: hot-deal-pulse 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>

<div
  id="rent-modal"
  class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-ink/40 backdrop-blur-sm transition-opacity" id="rent-modal-backdrop"></div>
  
  <div 
    class="relative w-full max-w-lg bg-white rounded-4xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 mx-4 flex flex-col max-h-[90vh]"
    id="rent-modal-card"
    role="dialog"
    aria-modal="true"
  >
    <button 
      id="rent-modal-close" 
      class="absolute top-4 right-4 p-2 text-ink-soft hover:text-ink transition-colors rounded-full hover:bg-slate-muted/20 z-10"
      aria-label="Cerrar modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="p-8 overflow-y-auto">
      <p class="eyebrow mb-2">Plan de renta</p>
      <h3 class="text-2xl font-display font-bold text-ink mb-6" id="rent-modal-title">Obtén tu Producto</h3>
      
      <div class="space-y-4 mb-5">
        <p class="text-sm font-medium text-ink-soft">Selecciona tu plan:</p>
        
        <div class="grid grid-cols-1 gap-3">
          <button type="button" class="plan-btn text-left p-4 border border-flame-500 bg-flame-50 rounded-2xl transition-colors" data-plan="6">
            <div class="flex justify-between items-center mb-1">
               <span class="text-sm font-bold text-ink">6 cuotas &middot; 3 meses</span>
            </div>
            <div class="flex justify-between items-center">
               <span class="text-base font-bold text-flame-600" id="cuota-6">$0 cada 2 semanas</span>
               <span class="text-xs text-slate-muted" id="buyout-6">Compra final: $0</span>
            </div>
          </button>
          
          <button type="button" class="plan-btn text-left p-4 border border-hairline bg-cream/60 rounded-2xl transition-colors hover:border-slate-300" data-plan="12">
            <div class="flex justify-between items-center mb-1">
               <span class="text-sm font-bold text-ink">12 cuotas &middot; 6 meses</span>
            </div>
            <div class="flex justify-between items-center">
               <span class="text-base font-bold text-flame-600" id="cuota-12">$0 cada 2 semanas</span>
               <span class="text-xs text-slate-muted" id="buyout-12">Compra final: $0</span>
            </div>
          </button>

          <button type="button" class="plan-btn text-left p-4 border border-hairline bg-cream/60 rounded-2xl transition-colors hover:border-slate-300" data-plan="18">
            <div class="flex justify-between items-center mb-1">
               <span class="text-sm font-bold text-ink">18 cuotas &middot; 9 meses</span>
            </div>
            <div class="flex justify-between items-center">
               <span class="text-base font-bold text-flame-600" id="cuota-18">$0 cada 2 semanas</span>
               <span class="text-xs text-slate-muted" id="buyout-18">Compra final: $0</span>
            </div>
          </button>

          <button type="button" class="plan-btn text-left p-4 border border-hairline bg-cream/60 rounded-2xl transition-colors hover:border-slate-300" data-plan="24">
            <div class="flex justify-between items-center mb-1">
               <span class="text-sm font-bold text-ink">24 cuotas &middot; 12 meses</span>
            </div>
            <div class="flex justify-between items-center">
               <span class="text-base font-bold text-flame-600" id="cuota-24">$0 cada 2 semanas</span>
               <span class="text-xs text-slate-muted" id="buyout-24">Compra final: $0</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Aclaratorias al finalizar alquiler -->
      <div class="mb-6 rounded-2xl border border-hairline bg-cream/40 p-4">
        <p class="text-xs font-semibold tracking-wide text-slate-muted uppercase mb-3">
          Después de terminar tu alquiler de <span id="post-rental-months">3</span> meses:
        </p>
        <ul class="space-y-2.5 text-sm font-medium text-ink">
          <li class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <svg class="h-4 w-4 text-flame-500 shrink-0" viewBox="0 0 20 20" fill="none">
                <path d="m5 10 3.5 3.5L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Renueva a un menor precio
            </span>
            <span class="hot-deal-badge inline-flex items-center gap-1.5 rounded-full bg-flame-500 px-2.5 py-0.5 text-[0.7rem] font-bold text-white uppercase tracking-wider shadow-sm">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-300 opacity-85"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-yellow-200"></span>
              </span>
              🔥 Hot deal
            </span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-flame-500 shrink-0" viewBox="0 0 20 20" fill="none">
              <path d="m5 10 3.5 3.5L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Cómpralo con descuento</span>
          </li>
        </ul>
      </div>

      <div class="bg-cream p-6 rounded-3xl mb-6 text-center border border-slate-muted/50">
        <p class="text-sm text-ink-soft mb-1">Total a pagar hoy (1ra quincena):</p>
        <div class="text-4xl font-display font-black text-ink tracking-tight" id="rent-modal-total">
          $0<span class="text-xl text-ink-soft font-medium"> cada 2 semanas</span>
        </div>
      </div>

      <button
        id="rent-modal-submit"
        class="w-full flex items-center justify-center gap-3 bg-white border border-slate-muted shadow-sm hover:shadow-md text-ink font-medium py-3.5 px-6 rounded-2xl transition-all hover:bg-slate-50 relative overflow-hidden"
      >
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span>Continuar con Google</span>
      </button>
      
      <p id="rent-modal-disclaimer" class="text-center text-xs text-ink-soft mt-4">
        Usamos Google solo para verificar tu identidad.<br/>No publicamos nada.
      </p>
    </div>
  </div>
</div>

<script>
  import { initSessionFromCookies, signInWithGoogle } from '../lib/supabase';
  import { saveRentSelection } from '../lib/rent-selection';

  const RENT_FLOW_NEXT = '/completar-registro';

  let isAuthenticated = false;

  let currentProduct = {
    slug: '',
    name: '',
    pricing: null,
    retail: 0
  };
  let selectedPlan = '6';

  const modal = document.getElementById('rent-modal');
  const backdrop = document.getElementById('rent-modal-backdrop');
  const card = document.getElementById('rent-modal-card');
  const closeBtn = document.getElementById('rent-modal-close');
  const title = document.getElementById('rent-modal-title');
  const total = document.getElementById('rent-modal-total');
  const submitBtn = document.getElementById('rent-modal-submit');
  const disclaimer = document.getElementById('rent-modal-disclaimer');
  const postRentalMonths = document.getElementById('post-rental-months');
  const planBtns = document.querySelectorAll('.plan-btn');

  initSessionFromCookies().then(session => {
    if (session) {
      isAuthenticated = true;
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Continuar</span><svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
        submitBtn.classList.remove('bg-white', 'border', 'border-slate-muted', 'text-ink', 'hover:bg-slate-50');
        submitBtn.classList.add('bg-flame-500', 'text-white', 'shadow-lg', 'shadow-flame-500/25', 'hover:bg-flame-600', 'border-transparent');
      }
      if (disclaimer) {
        disclaimer.style.display = 'none';
      }
    }
  });

  const formatMoney = (val) => `$${val}`;

  const updatePricesUI = () => {
    if (!currentProduct.pricing) return;
    
    ['6', '12', '18', '24'].forEach(plan => {
      const p = currentProduct.pricing[plan];
      if (p) {
        const cuotaEl = document.getElementById(`cuota-${plan}`);
        const buyoutEl = document.getElementById(`buyout-${plan}`);
        if (cuotaEl) cuotaEl.textContent = `${formatMoney(p.cuota)} cada 2 semanas`;
        if (buyoutEl) buyoutEl.textContent = `Compra final: ${formatMoney(p.buyout)}`;
      }
    });

    const selectedPricing = currentProduct.pricing[selectedPlan];
    if (selectedPricing && total) {
      total.innerHTML = `${formatMoney(selectedPricing.cuota)}<span class="text-xl text-ink-soft font-medium"> cada 2 semanas</span>`;
    }
    
    const monthsMap = { '6': '3', '12': '6', '18': '9', '24': '12' };
    if (postRentalMonths) {
      postRentalMonths.textContent = monthsMap[selectedPlan];
    }
  };

  const selectPlan = (plan) => {
    selectedPlan = plan;
    
    planBtns.forEach(btn => {
      if (btn.getAttribute('data-plan') === plan) {
        btn.classList.remove('border-hairline', 'bg-cream/60', 'hover:border-slate-300');
        btn.classList.add('border-flame-500', 'bg-flame-50');
      } else {
        btn.classList.add('border-hairline', 'bg-cream/60', 'hover:border-slate-300');
        btn.classList.remove('border-flame-500', 'bg-flame-50');
      }
    });
    
    updatePricesUI();
  };

  planBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectPlan(btn.getAttribute('data-plan'));
    });
  });

  const openModal = (slug, name, pricing, retail) => {
    if (!modal || !card || !title) return;

    currentProduct = { slug, name, pricing, retail };
    
    selectPlan('6');

    title.textContent = `Obtén tu ${name}`;
    
    modal.classList.remove('hidden');
    void modal.offsetWidth;
    modal.classList.remove('opacity-0');
    card.classList.remove('scale-95');
    card.classList.add('scale-100');
    
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal || !card) return;
    
    modal.classList.add('opacity-0');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  document.addEventListener('click', (e) => {
    const target = e.target;
    const btn = target.closest('[data-rent-modal]');
    
    if (btn) {
      const slug = btn.getAttribute('data-product-slug');
      const name = btn.getAttribute('data-product-name');
      const pricingStr = btn.getAttribute('data-product-pricing');
      const retailStr = btn.getAttribute('data-product-retail');

      if (slug && name && pricingStr) {
        try {
          const pricing = JSON.parse(pricingStr);
          const retail = retailStr ? parseFloat(retailStr) : 0;
          openModal(slug, name, pricing, retail);
        } catch (err) {
          console.error("Error parsing product pricing", err);
        }
      }
    }
  });

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (backdrop) backdrop.addEventListener('click', closeModal);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  if (submitBtn) {
    submitBtn.addEventListener('click', async () => {
      if (!currentProduct.pricing) return;
      
      const plan = selectedPlan;
      const selectedPricing = currentProduct.pricing[plan];
      const cuota = selectedPricing.cuota;
      const buyout = selectedPricing.buyout;

      saveRentSelection({
        product_slug: currentProduct.slug,
        product_name: currentProduct.name,
        plan: plan,
        cuota: cuota,
        buyout: buyout
      });

      if (isAuthenticated) {
        window.location.href = RENT_FLOW_NEXT;
        return;
      }

      submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
      const originalHTML = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span class="inline-block w-5 h-5 border-2 border-slate-300 border-t-ink rounded-full animate-spin mr-2"></span><span>Conectando...</span>';

      try {
        await signInWithGoogle(RENT_FLOW_NEXT);
      } catch {
        alert('No se pudo conectar con Google. Por favor, intenta de nuevo.');
        submitBtn.innerHTML = originalHTML;
        submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      }
    });
  }
</script>
