---
import ProductImage from './ProductImage.astro';
import { getProducts, PLAN_KEYS, PLAN_LABELS } from '../data/products';
import type { PlanKey } from '../data/products';

const rawProducts = await getProducts();
const products = [...rawProducts].sort((a, b) => {
  if (a.entrega === 'inmediata' && b.entrega === 'pedido') return -1;
  if (a.entrega === 'pedido' && b.entrega === 'inmediata') return 1;
  return 0;
});

const plans = [
  { key: '6', cuotas: '6 cuotas', meses: '3 meses' },
  { key: '12', cuotas: '12 cuotas', meses: '6 meses' },
  { key: '18', cuotas: '18 cuotas', meses: '9 meses' },
  { key: '24', cuotas: '24 cuotas', meses: '12 meses' }
];
---

<section id="catalogo" class="scroll-mt-24 bg-white py-20 sm:py-28">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Catálogo de lanzamiento</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl lg:text-[3.4rem]">
        Paga poco a poco.
        <br class="hidden sm:block" />
        <span class="text-flame-500">Alquílalo hoy</span> y al final decide si
        <span class="text-flame-500">te lo quedas</span>.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Ahorra y ten lo último en tecnología con rentas a 3 meses.
      </p>
    </div>

    <!-- Selector de planes -->
    <div class="reveal mt-10 flex flex-wrap justify-center gap-2">
      {
        plans.map(plan => (
          <button
            type="button"
            data-plan={plan.key}
            class={`plan-selector-btn px-5 py-2.5 rounded-full text-sm font-semibold border border-hairline transition-all cursor-pointer ${
              plan.key === '6' 
                ? 'bg-ink text-white border-ink shadow-lg shadow-ink/15'
                : 'bg-white text-ink-soft hover:border-flame-300 hover:text-flame-600'
            }`}
          >
            {plan.cuotas} <span class="text-xs font-normal text-slate-muted ml-1">· {plan.meses}</span>
          </button>
        ))
      }
    </div>

    <!-- Grid de productos -->
    <div class="reveal mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p, i) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-hairline bg-white transition-all hover:border-flame-200 hover:shadow-2xl hover:shadow-ink/6" data-pricing={JSON.stringify(p.pricing)}>
            <div class="relative p-3 pb-0">
              <ProductImage slug={p.slug} name={p.name} class="aspect-4/3" />
              {p.badge && (
                <span class="absolute top-6 left-6 z-20 rounded-full bg-ink px-3 py-1.5 text-[0.7rem] font-semibold tracking-wide text-white uppercase">
                  {p.badge}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6 pt-4">
              <p class="text-xs font-semibold tracking-widest text-slate-muted uppercase">{p.category}</p>
              <h3 class="mt-1.5 font-display text-xl font-bold">{p.name}</h3>
              <p class="mt-2 text-base leading-relaxed text-ink-soft">{p.blurb}</p>

              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.specs.map((spec) => (
                  <li class="rounded-full bg-cream px-2.5 py-1 text-[0.75rem] font-medium text-ink-soft">{spec}</li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                <div class="flex items-end justify-between gap-3 border-t border-hairline pt-5">
                  <div>
                    <p class="text-[0.8rem] text-slate-muted">Paga</p>
                    <p class="font-display text-3xl font-bold text-ink">
                      $<span class="product-cuota-price">{p.pricing['6'].cuota}</span><span class="text-base font-semibold text-slate-muted"> cada 2 semanas</span>
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-[0.8rem] text-slate-muted">Precio final de compra</p>
                    <p class="font-display text-base font-semibold text-slate-muted">$<span class="product-buyout-price">{p.pricing['6'].buyout}</span></p>
                  </div>
                </div>

                {p.entrega === 'inmediata' ? (
                  <button
                    type="button"
                    data-rent-modal
                    data-product-slug={p.slug}
                    data-product-name={p.name}
                    data-product-pricing={JSON.stringify(p.pricing)}
                    data-product-retail={p.retail}
                    class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-flame-500 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-flame-500/25 transition-all hover:bg-flame-600 hover:shadow-xl active:scale-[0.98] cursor-pointer"
                  >
                    Obtenlo ahora
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path
                        d="M4 10h11m0 0-4-4m4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                ) : (
                  <button
                    type="button"
                    data-waitlist-modal
                    data-product-name={p.name}
                    data-product-pricing={JSON.stringify(p.pricing)}
                    data-product-retail={p.retail}
                    class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-ink px-5 py-3.5 text-sm font-semibold text-white transition-all hover:bg-flame-500 active:scale-[0.98] cursor-pointer"
                  >
                    Lista de espera
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path
                        d="M10 3v7l4 2"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" fill="none" />
                    </svg>
                  </button>
                )}
              </div>
            </div>
          </article>
        ))
      }

      <!-- Tarjeta "pide otro producto" -->
      <article
        class="flex flex-col justify-between rounded-3xl border border-dashed border-flame-300 bg-flame-50 p-7 sm:col-span-2 lg:col-span-1"
      >
        <div>
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm">✨</span>
          <h3 class="mt-5 font-display text-xl font-bold">No esta lo que buscas?</h3>
          <p class="mt-2.5 text-base leading-relaxed text-ink-soft">
            Este es solo el catalogo de lanzamiento. Dinos que producto quieres rentar y lo
            sumamos a la lista: los mas pedidos entran primero.
          </p>
        </div>
        <a
          href="#lista-de-espera"
          class="mt-7 inline-flex items-center justify-center gap-2 rounded-full border border-ink/12 bg-white px-5 py-3.5 text-sm font-semibold text-ink transition-all hover:border-flame-400 hover:text-flame-600"
        >
          Pedir un producto
        </a>
      </article>
    </div>

    <p class="reveal mt-8 text-center text-sm text-slate-muted">
      Precios en USD, referenciales para el lanzamiento. El monto final se confirma al aprobar tu solicitud.
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    // Plan selector
    const planBtns = document.querySelectorAll('.plan-selector-btn');
    const articles = document.querySelectorAll('article[data-pricing]');
    
    window.__selectedPlan = '6';

    const activeClasses = ['bg-ink', 'text-white', 'border-ink', 'shadow-lg', 'shadow-ink/15'];
    const inactiveClasses = ['bg-white', 'text-ink-soft', 'hover:border-flame-300', 'hover:text-flame-600'];

    planBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const plan = btn.getAttribute('data-plan');
        if (!plan) return;
        
        window.__selectedPlan = plan;

        // Update active states
        planBtns.forEach(b => {
          if (b === btn) {
            b.classList.remove(...inactiveClasses);
            b.classList.add(...activeClasses);
          } else {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
          }
        });

        // Update product prices
        articles.forEach(article => {
          try {
            const pricingData = JSON.parse(article.getAttribute('data-pricing') || '{}');
            const planPricing = pricingData[plan];
            if (planPricing) {
              const cuotaEl = article.querySelector('.product-cuota-price');
              const buyoutEl = article.querySelector('.product-buyout-price');
              if (cuotaEl) cuotaEl.textContent = planPricing.cuota;
              if (buyoutEl) buyoutEl.textContent = planPricing.buyout;
            }
          } catch (e) {
            console.error('Error parsing pricing data', e);
          }
        });
      });
    });

    // Preselecciona el producto en el formulario de lista de espera.
    document.querySelectorAll('[data-product-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        const select = document.querySelector('#lead-producto');
        const name = cta.getAttribute('data-product-cta');
        if (select && name) select.value = name;
      });
    });
  })();
</script>
