---
import { products } from '../data/products';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

const perks = [
  'Entras primero cuando abramos',
  'Condiciones preferenciales de lanzamiento',
  'Tu voto decide que productos sumamos',
];
---

<section id="lista-de-espera" class="relative scroll-mt-24 overflow-hidden bg-ink py-20 sm:py-28">
  <!-- Degradado de marca -->
  <div
    class="pointer-events-none absolute -bottom-[45%] -left-[15%] h-[110%] w-[85%] rounded-[50%] opacity-45 blur-3xl brand-gradient"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 right-[-15%] h-[34rem] w-[34rem] rounded-full bg-flame-500/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <!-- Copy -->
      <div class="reveal">
        <p class="eyebrow text-flame-400">Lista de espera</p>
        <h2 class="mt-5 text-3xl leading-[1.1] font-bold text-white sm:text-5xl">
          Apuntate y elige
          <span class="text-flame-400">que producto quieres</span> primero.
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/70">
          Todavia no estamos abiertos al publico. Dejanos tus datos y te avisamos apenas
          puedas rentar. Sin compromiso y sin pagar nada ahora.
        </p>

        <ul class="mt-9 space-y-4">
          {
            perks.map((perk) => (
              <li class="flex items-center gap-3 text-[0.975rem] font-medium text-white/85">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sun-400 text-ink">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="m3 7.3 2.6 2.6L11 4.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                {perk}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Formulario -->
      <div class="reveal">
        <div class="rounded-4xl bg-white p-6 shadow-2xl shadow-black/25 sm:p-9">
          <form id="lead-form" novalidate class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="lead-nombre" class="mb-1.5 block text-sm font-semibold text-ink">Nombre</label>
                <input
                  id="lead-nombre"
                  name="nombre"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Como te llamas?"
                  class="w-full rounded-2xl border border-hairline bg-cream/50 px-4 py-3.5 text-[0.95rem] text-ink transition-colors placeholder:text-slate-muted/70 focus:border-flame-400 focus:bg-white focus:outline-none"
                />
              </div>

              <div>
                <label for="lead-ciudad" class="mb-1.5 block text-sm font-semibold text-ink">Ciudad</label>
                <input
                  id="lead-ciudad"
                  name="ciudad"
                  type="text"
                  autocomplete="address-level2"
                  placeholder="Caracas, Valencia..."
                  class="w-full rounded-2xl border border-hairline bg-cream/50 px-4 py-3.5 text-[0.95rem] text-ink transition-colors placeholder:text-slate-muted/70 focus:border-flame-400 focus:bg-white focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="lead-email" class="mb-1.5 block text-sm font-semibold text-ink">Correo</label>
              <input
                id="lead-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="tucorreo@email.com"
                class="w-full rounded-2xl border border-hairline bg-cream/50 px-4 py-3.5 text-[0.95rem] text-ink transition-colors placeholder:text-slate-muted/70 focus:border-flame-400 focus:bg-white focus:outline-none"
              />
            </div>

            <div>
              <label for="lead-telefono" class="mb-1.5 block text-sm font-semibold text-ink">
                Telefono <span class="font-normal text-slate-muted">(opcional)</span>
              </label>
              <input
                id="lead-telefono"
                name="telefono"
                type="tel"
                autocomplete="tel"
                placeholder="+58 412 000 0000"
                class="w-full rounded-2xl border border-hairline bg-cream/50 px-4 py-3.5 text-[0.95rem] text-ink transition-colors placeholder:text-slate-muted/70 focus:border-flame-400 focus:bg-white focus:outline-none"
              />
            </div>

            <div>
              <label for="lead-producto" class="mb-1.5 block text-sm font-semibold text-ink">
                Que quieres rentar primero?
              </label>
              <select
                id="lead-producto"
                name="producto"
                required
                class="w-full appearance-none rounded-2xl border border-hairline bg-cream/50 bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22m5%208%205%205%205-5%22%20stroke%3D%22%237b736d%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22/%3E%3C/svg%3E')] bg-[length:1.25rem] bg-[position:right_1rem_center] bg-no-repeat px-4 py-3.5 pr-11 text-[0.95rem] text-ink transition-colors focus:border-flame-400 focus:bg-white focus:outline-none"
              >
                <option value="">Selecciona una opcion</option>
                {products.map((p) => <option value={p.name}>{p.name}</option>)}
                <option value="Otro">Otro producto (lo escribo abajo)</option>
              </select>
            </div>

            <div>
              <label for="lead-mensaje" class="mb-1.5 block text-sm font-semibold text-ink">
                Que otro producto te gustaria? <span class="font-normal text-slate-muted">(opcional)</span>
              </label>
              <textarea
                id="lead-mensaje"
                name="mensaje"
                rows="2"
                maxlength="500"
                placeholder="Una PlayStation, una nevera, un aire acondicionado..."
                class="w-full resize-none rounded-2xl border border-hairline bg-cream/50 px-4 py-3.5 text-[0.95rem] text-ink transition-colors placeholder:text-slate-muted/70 focus:border-flame-400 focus:bg-white focus:outline-none"
              ></textarea>
            </div>

            <!-- Honeypot anti-spam: invisible para personas -->
            <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
              <label for="lead-website">No llenar</label>
              <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <button
              type="submit"
              data-submit
              class="flex w-full items-center justify-center gap-2 rounded-full bg-flame-500 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-flame-500/25 transition-all hover:bg-flame-600 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span data-submit-label>Apuntarme a la lista</span>
              <svg
                data-spinner
                class="hidden h-4.5 w-4.5 animate-spin"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2.5" opacity="0.3"></circle>
                <path d="M18 10a8 8 0 0 0-8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
              </svg>
            </button>

            <p class="text-center text-[0.8rem] leading-relaxed text-slate-muted">
              Usamos tus datos solo para avisarte del lanzamiento. Nada de spam, y puedes
              pedirnos que los borremos cuando quieras.
            </p>

            <p
              data-form-error
              role="alert"
              class="hidden rounded-2xl bg-red-50 px-4 py-3 text-center text-[0.875rem] font-medium text-red-700"
            >
            </p>
          </form>

          <!-- Estado de exito -->
          <div data-form-success class="hidden py-6 text-center" role="status">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-flame-50">
              <svg class="h-8 w-8 text-flame-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="m6 12.5 4 4 8-9"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3 class="mt-6 font-display text-2xl font-bold">Listo, estas dentro!</h3>
            <p class="mx-auto mt-3 max-w-sm text-[0.975rem] leading-relaxed text-ink-soft">
              Te escribiremos al correo apenas abramos. Gracias por ayudarnos a construir Lendix.
            </p>
            <p class="mt-6 text-sm text-slate-muted">
              Conoces a alguien que lo necesita? Comparteles
              <span class="font-semibold text-ink">lendix.app</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  (function () {
    const form = document.getElementById('lead-form');
    if (!form) return;

    const submit = form.querySelector('[data-submit]');
    const label = form.querySelector('[data-submit-label]');
    const spinner = form.querySelector('[data-spinner]');
    const errorBox = form.querySelector('[data-form-error]');
    const successBox = document.querySelector('[data-form-success]');

    const configured = Boolean(supabaseUrl && supabaseKey && supabaseUrl.startsWith('http'));

    const showError = (msg) => {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };

    const setLoading = (loading) => {
      if (submit) submit.disabled = loading;
      if (label) label.textContent = loading ? 'Enviando...' : 'Apuntarme a la lista';
      if (spinner) spinner.classList.toggle('hidden', !loading);
    };

    // Atribucion de campanas: de que anuncio vino este lead.
    const attribution = () => {
      const params = new URLSearchParams(window.location.search);
      return {
        utm_source: params.get('utm_source'),
        utm_medium: params.get('utm_medium'),
        utm_campaign: params.get('utm_campaign'),
        utm_content: params.get('utm_content'),
        referrer: document.referrer || null,
      };
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('hidden');

      const data = new FormData(form);

      // Honeypot: si viene lleno, es un bot. Fingimos exito y no guardamos nada.
      if (String(data.get('website') || '').trim()) {
        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
        return;
      }

      const nombre = String(data.get('nombre') || '').trim();
      const email = String(data.get('email') || '').trim();
      const producto = String(data.get('producto') || '').trim();

      if (!nombre) return showError('Escribe tu nombre para poder saludarte bien.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return showError('Revisa tu correo, parece que tiene un error.');
      if (!producto) return showError('Dinos que producto te interesa mas.');

      const payload = {
        nombre,
        email: email.toLowerCase(),
        telefono: String(data.get('telefono') || '').trim() || null,
        ciudad: String(data.get('ciudad') || '').trim() || null,
        producto_interes: producto,
        mensaje: String(data.get('mensaje') || '').trim() || null,
        ...attribution(),
      };

      if (!configured) {
        // Supabase todavia no esta conectado: no perdemos el lead en silencio.
        console.warn('[Lendix] Supabase sin configurar. Lead capturado solo en consola:', payload);
        showError('Todavia estamos conectando el formulario. Escribenos a hola@lendix.app y te apuntamos.');
        return;
      }

      setLoading(true);

      try {
        const res = await fetch(supabaseUrl.replace(/\/$/, '') + '/rest/v1/waitlist_lead', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: supabaseKey,
            Authorization: 'Bearer ' + supabaseKey,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const body = await res.text();
          // 23505 = unique_violation: ese correo ya estaba en la lista.
          if (res.status === 409 || body.includes('23505')) {
            form.classList.add('hidden');
            successBox?.classList.remove('hidden');
            return;
          }
          throw new Error(body || 'HTTP ' + res.status);
        }

        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
        successBox?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (err) {
        console.error('[Lendix] Error guardando el lead:', err);
        showError('No pudimos guardar tus datos. Intenta de nuevo o escribenos a hola@lendix.app');
      } finally {
        setLoading(false);
      }
    });
  })();
</script>
