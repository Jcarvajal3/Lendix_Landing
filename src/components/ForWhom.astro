---
const profiles = [
  {
    who: 'Estudiantes',
    need: '"Necesito una laptop para la U, pero no tengo $700."',
    solve: 'Rentas un ThinkPad por $38 al mes y la devuelves cuando te gradues.',
  },
  {
    who: 'Freelancers y remotos',
    need: '"Mi equipo ya no da y no quiero descapitalizarme."',
    solve: 'Un MacBook Air por $45 al mes. Si el proyecto termina, lo devuelves.',
  },
  {
    who: 'Familias mudandose',
    need: '"Estrene apartamento y me falta todo el electrodomestico."',
    solve: 'Lavadora y televisor rentados el mismo mes, sin vaciar los ahorros.',
  },
  {
    who: 'Gamers',
    need: '"Quiero probar la consola nueva sin casarme con ella."',
    solve: 'Switch 2 por $32 al mes. Te aburriste en tres meses? La devuelves.',
  },
];
---

<section class="bg-cream py-20 sm:py-28">
  <div class="container-x">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow">Para quien es</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl">
        Si alguna vez dijiste <span class="text-flame-500">"lo necesito, pero no ahorita"</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Lendix existe justo para ese momento.
      </p>
    </div>

    <div class="reveal mt-14 grid gap-5 sm:grid-cols-2">
      {
        profiles.map((p) => (
          <article class="rounded-3xl border border-white/80 bg-white p-8 shadow-sm">
            <span class="inline-flex rounded-full bg-flame-50 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-flame-700 uppercase">
              {p.who}
            </span>
            <p class="mt-5 font-display text-xl leading-snug font-semibold text-ink">{p.need}</p>
            <div class="mt-5 flex gap-3 border-t border-hairline pt-5">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-flame-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.16" />
                <path
                  d="m6 10.3 2.6 2.6L14 7.5"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <p class="text-[0.95rem] leading-relaxed text-ink-soft">{p.solve}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
