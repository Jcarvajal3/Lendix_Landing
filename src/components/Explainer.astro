---
const analogies = [
  {
    emoji: '🏠',
    title: 'Como alquilar un apartamento',
    text: 'No eres el dueno, pero vives ahi y lo usas todos los dias. Pagas cada mes. Si te mudas, entregas las llaves y ya.',
  },
  {
    emoji: '📺',
    title: 'Como tu suscripcion de streaming',
    text: 'Pagas al mes y ves lo que quieras. Si un mes ya no lo quieres, cancelas. Nadie te obliga a quedarte.',
  },
  {
    emoji: '📱',
    title: 'Lendix es las dos cosas',
    text: 'Pero con cosas fisicas: una consola, una laptop, una lavadora, un televisor. Llegan a tu casa y son tuyas para usar.',
  },
];

const notThis = [
  'No es un prestamo de dinero.',
  'No es comprar a cuotas: no terminas debiendo el total.',
  'No hay que pagar todo el producto para poder usarlo.',
];

const isThis = [
  'Pagas una renta fija cada mes.',
  'Usas el producto como si fuera tuyo.',
  'Lo devuelves cuando quieras y dejas de pagar.',
];
---

<section id="que-es" class="scroll-mt-24 bg-white py-20 sm:py-28">
  <div class="container-x">
    <!-- Declaracion grande, estilo manual de marca -->
    <div class="reveal mx-auto max-w-4xl text-center">
      <p class="eyebrow">Empecemos por lo basico</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl lg:text-[3.4rem]">
        No compras el producto.
        <br class="hidden sm:block" />
        <span class="text-flame-500">Pagas por usarlo</span>, el tiempo que
        <span class="text-sun-500">tu decidas</span>.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Eso es todo. Si esa frase te quedo clara, ya entendiste Lendix. Abajo lo explicamos
        todavia mas despacio.
      </p>
    </div>

    <!-- Analogias -->
    <div class="reveal mt-16 grid gap-5 md:grid-cols-3">
      {
        analogies.map((item, i) => (
          <article
            class={`rounded-3xl border p-7 transition-shadow hover:shadow-xl hover:shadow-ink/5 ${
              i === 2 ? 'border-flame-200 bg-flame-50' : 'border-hairline bg-white'
            }`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm ring-1 ring-hairline">
              {item.emoji}
            </span>
            <h3 class="mt-5 font-display text-lg font-bold">{item.title}</h3>
            <p class="mt-2.5 text-[0.975rem] leading-relaxed text-ink-soft">{item.text}</p>
          </article>
        ))
      }
    </div>

    <!-- Que NO es / Que SI es -->
    <div class="reveal mt-6 grid gap-5 md:grid-cols-2">
      <div class="rounded-3xl border border-hairline bg-white p-7 sm:p-9">
        <h3 class="font-display text-xl font-bold text-slate-muted">Lo que Lendix NO es</h3>
        <ul class="mt-6 space-y-4">
          {
            notThis.map((item) => (
              <li class="flex gap-3 text-[0.975rem] leading-relaxed text-ink-soft">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-slate-muted" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.12" />
                  <path d="m7 7 6 6M13 7l-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-3xl bg-ink p-7 sm:p-9">
        <h3 class="font-display text-xl font-bold text-white">Lo que Lendix SI es</h3>
        <ul class="mt-6 space-y-4">
          {
            isThis.map((item) => (
              <li class="flex gap-3 text-[0.975rem] leading-relaxed text-white/80">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-sun-400" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.2" />
                  <path
                    d="m6 10.3 2.6 2.6L14 7.5"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
