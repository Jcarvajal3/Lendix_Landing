---
const perks = [
  {
    title: 'Envio a tu casa',
    text: 'Te llevamos el producto a tu direccion, sin costo extra en tu renta.',
    icon: 'truck',
  },
  {
    title: 'Cobertura contra robo',
    text: 'Si te lo roban, no pierdes tu dinero ni quedas debiendo el equipo.',
    icon: 'shield',
  },
  {
    title: 'Soporte y reparaciones',
    text: 'Fallo por uso normal? Lo reparamos o te lo cambiamos, sin discutir.',
    icon: 'wrench',
  },
  {
    title: 'Cuota fija, sin sorpresas',
    text: 'El mismo monto todos los meses. Sabes exactamente cuanto vas a pagar.',
    icon: 'tag',
  },
  {
    title: 'Recogida gratis',
    text: 'Cuando decidas devolverlo, pasamos a buscarlo. No pagas por salir.',
    icon: 'box',
  },
  {
    title: 'Opcion de cambiar de equipo',
    text: 'Necesitas mas potencia o un modelo nuevo? Cambias sin empezar de cero.',
    icon: 'swap',
  },
];

const paths: Record<string, string> = {
  truck: 'M2 6.5h9v8H2v-8Zm9 3h3.5l2.5 2.5v2.5H11v-5ZM5 17.5a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Zm9.5 0a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z',
  shield: 'M10 2.5 3.8 5v5c0 3.6 2.5 6.6 6.2 7.5 3.7-.9 6.2-3.9 6.2-7.5V5L10 2.5Z',
  wrench:
    'M13.4 3.2a4.2 4.2 0 0 0-4.2 5.3l-6 6 2.3 2.3 6-6a4.2 4.2 0 0 0 5.3-4.2l-2.6 2.6-2.1-.6-.6-2.1 2.6-2.6Z',
  tag: 'M3 3h6.5L17 10.5 10.5 17 3 9.5V3Zm3 2.6a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Z',
  box: 'M10 2.5 17 6v8l-7 3.5L3 14V6l7-3.5Zm0 0L3 6l7 3.5L17 6M10 9.5V17.5',
  swap: 'M3 7h11m0 0-3-3m3 3-3 3M17 13H6m0 0 3-3m-3 3 3 3',
};
---

<section class="bg-white py-20 sm:py-28">
  <div class="container-x">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Todo incluido</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl">
        Tu renta ya trae <span class="text-flame-500">todo lo que importa</span>.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        No hay costos escondidos que aparecen despues. Lo que ves en la cuota es lo que pagas.
      </p>
    </div>

    <div class="reveal mt-14 grid gap-px overflow-hidden rounded-4xl bg-hairline sm:grid-cols-2 lg:grid-cols-3">
      {
        perks.map((perk) => (
          <div class="bg-white p-8 transition-colors hover:bg-cream/60">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-flame-50 text-flame-600">
              <svg class="h-5.5 w-5.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d={paths[perk.icon]}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <h3 class="mt-5 font-display text-lg font-bold">{perk.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{perk.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
