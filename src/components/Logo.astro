---
/**
 * Icono + wordmark oficial de la marca (public/Logo Lendix.svg y
 * "Logo Lendix White.svg"): mismo trazo en los dos archivos, solo cambia el
 * color solido. Se recorta el viewBox al arte real (los originales traen un
 * rectangulo de fondo pensado para tarjetas, no para incrustar en UI).
 */
interface Props {
  class?: string;
  /** 'ink' = trazo en naranja de marca, para fondos claros. 'white' = trazo blanco, para fondos oscuros. */
  tone?: 'ink' | 'white';
}

const { class: className = '', tone = 'ink' } = Astro.props;
const color = tone === 'white' ? '#FFFFFF' : '#FF7648';
