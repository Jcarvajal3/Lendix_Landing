---
interface Props {
  class?: string;
  /** Color del texto de la marca */
  tone?: 'ink' | 'white';
}

const { class: className = '', tone = 'ink' } = Astro.props;
const textColor = tone === 'white' ? 'text-white' : 'text-ink';
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="0 0 32 32"
    class="h-8 w-8 shrink-0"
    role="img"
    aria-label="Lendix"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="lendix-mark" x1="2" y1="30" x2="30" y2="2" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#F2530F"></stop>
        <stop offset="55%" stop-color="#FF6B2C"></stop>
        <stop offset="100%" stop-color="#FFC94A"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#lendix-mark)"></rect>
    <!-- Flecha ciclica: tomar y devolver -->
    <path
      d="M10.5 13.2a6 6 0 0 1 10.2-2.1"
      stroke="#fff"
      stroke-width="2.1"
      stroke-linecap="round"></path>
    <path d="M21.5 8.3v3.4h-3.4" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
    <path
      d="M21.5 18.8a6 6 0 0 1-10.2 2.1"
      stroke="#fff"
      stroke-width="2.1"
      stroke-linecap="round"></path>
    <path d="M10.5 23.7v-3.4h3.4" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class={`font-display text-[1.35rem] font-bold tracking-tight ${textColor}`}>Lendix</span>
</span>
