---
import ProductImage from './ProductImage.astro';
import { getProducts } from '../data/products';
import { hasWhatsapp, whatsappLink } from '../data/site';

const products = await getProducts();

// El precio de entrada se calcula del catalogo real: nunca puede mentir.
const cheapest = products.reduce((a, b) => (b.biweekly < a.biweekly ? b : a));
const star = products.find((p) => p.slug === 'nintendo-switch-2') ?? products[0];

const garantias = [
  'Delivery gratis a tu hogar',
  '0$ de inicial y depósito',
  'Usa siempre la última tecnología',
  'x30 veces más barato que comprar',
];
---

<section id="top" class="relative overflow-hidden bg-cream pt-[4.5rem]">
  <!-- Degradado firma del manual de marca (invertido: naranja a la derecha) -->
  <div
    class="pointer-events-none absolute -right-[18%] -bottom-[38%] h-[120%] w-[95%] rounded-[50%] opacity-90 blur-3xl brand-gradient-flip"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-24 right-[-10%] h-[36rem] w-[36rem] rounded-full bg-sun-200/50 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative">
    <div class="grid items-center gap-8 py-8 sm:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:py-24">
      <!-- Copy -->
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-flame-200 bg-white/80 px-3.5 py-1 text-xs font-semibold tracking-wide text-flame-700 backdrop-blur"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-flame-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-flame-500"></span>
          </span>
          Rentando en Venezuela
        </span>

        <h1 class="mt-3 text-[2.1rem] leading-[1.06] font-bold sm:text-6xl lg:text-[4.15rem]">
          Deja de comprar.
          <br />
          <span class="text-flame-700">Usalo por un alquiler</span>
          quincenal.
        </h1>

        <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-soft">
          Consolas, laptops y electrodomésticos por una cuota fija cada quincena. Úsalo. Devuélvelo. O quédatelo con descuento.
        </p>

        <!-- CTA principal: el usuario elige producto y lo renta -->
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#catalogo"
            data-cta="hero-primario"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-flame-500 px-7 py-4 text-base font-semibold text-white shadow-lg shadow-flame-500/30 transition-all hover:bg-flame-600 hover:shadow-xl active:scale-[0.98]"
          >
            Elegir mi producto
            <svg class="h-4.5 w-4.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4 10h11m0 0-4-4m4 4-4 4"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>

          {
            hasWhatsapp && (
              <a
                href={whatsappLink('Hola Lendix, quiero rentar un equipo. Me pueden ayudar?')}
                target="_blank"
                rel="noopener"
                data-cta="hero-whatsapp"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-ink/12 bg-white px-6 py-4 text-base font-semibold text-ink transition-all hover:border-ink/25 hover:shadow-md active:scale-[0.98]"
              >
                <svg class="h-5 w-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.58.26 1.04.41 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z" />
                </svg>
                Preguntar por WhatsApp
              </a>
            )
          }
        </div>

        <p class="mt-3 text-sm text-slate-muted">
          Solicitarlo toma 1 minuto. Te respondemos el mismo dia.
        </p>

        <!-- Micro-garantias: quitan el miedo antes de que aparezca -->
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {
            garantias.map((g) => (
              <li class="inline-flex items-center gap-1.5 text-[0.875rem] font-medium text-ink-soft">
                <svg class="h-4 w-4 shrink-0 text-flame-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.16" />
                  <path
                    d="m6 10.3 2.6 2.6L14 7.5"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {g}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Producto destacado: precio y boton de renta a la vista -->
      <div class="relative mx-auto w-full max-w-[20rem] sm:max-w-[26rem] lg:max-w-none">
        <div
          class="card-surface group relative overflow-hidden p-3 shadow-2xl shadow-ink/10 ring-1 ring-white/60 backdrop-blur"
        >
          <ProductImage
            slug={star.slug}
            name={star.name}
            loading="eager"
            class="aspect-4/3 rounded-2xl"
            sizes="(min-width: 1024px) 26rem, 90vw"
          />

          <div class="px-4 pt-5 pb-3">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold tracking-widest text-slate-muted uppercase">{star.category}</p>
                <h2 class="mt-1 font-display text-xl font-bold">{star.name}</h2>
              </div>
              {star.badge && (
                <span class="shrink-0 rounded-full bg-sun-100 px-3 py-1 text-xs font-semibold text-sun-600">
                  {star.badge}
                </span>
              )}
            </div>

            <div class="mt-5 flex items-end justify-between gap-4 border-t border-hairline pt-5">
              <div>
                <p class="text-sm text-slate-muted">Renta desde</p>
                <p class="font-display text-3xl font-bold text-ink">
                  ${star.biweekly}<span class="text-base font-semibold text-slate-muted">/quincena</span>
                </p>
              </div>
              <div class="text-right">
                <p class="text-sm text-slate-muted">Comprarla cuesta</p>
                <p class="font-display text-lg font-semibold text-slate-muted line-through">${star.retail}</p>
              </div>
            </div>

            <button
              type="button"
              data-rentar={star.name}
              data-precio={star.biweekly}
              class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-ink px-5 py-3.5 text-sm font-semibold text-white transition-all hover:bg-flame-500 active:scale-[0.98]"
            >
              Rentar esta {star.name}
            </button>
          </div>
        </div>

        <!-- Chip flotante: sobre la imagen, lejos del precio -->
        <div
          class="absolute -top-5 -right-4 hidden rounded-2xl border border-hairline bg-white px-4 py-3 shadow-xl shadow-ink/10 sm:block lg:-right-8"
        >
          <p class="text-[0.7rem] font-semibold tracking-widest text-slate-muted uppercase">Te aburriste?</p>
          <p class="mt-0.5 text-sm font-semibold text-ink">Devuelvela y dejas de pagar</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Curva de transicion hacia la seccion blanca -->
  <div class="relative h-10 sm:h-16" aria-hidden="true">
    <svg class="absolute bottom-0 h-full w-full" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0 80h1440V0c-240 52-560 68-1440 22V80Z" fill="#fff"></path>
    </svg>
  </div>
</section>
