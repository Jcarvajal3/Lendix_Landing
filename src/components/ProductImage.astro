---
/**
 * Imagen de producto sobre fondo blanco.
 *
 * Si algun producto se agrega sin foto todavia (se espera en
 * `public/products/<slug>.webp`), el <img> falla en silencio y queda visible
 * el nombre del producto sobre el fondo blanco, en vez de un icono de imagen
 * rota.
 */
interface Props {
  slug: string;
  name: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const { slug, name, class: className = '', loading = 'lazy', sizes = '(min-width: 1024px) 22rem, 90vw' } = Astro.props;
---

<div class={`relative isolate flex items-center justify-center p-3 ${className}`}>
  <!-- Marca de agua: visible solo mientras no haya foto -->
  <div class="absolute inset-0 flex items-center justify-center p-6 text-center" aria-hidden="true">
    <span class="font-display text-sm font-semibold tracking-wide text-ink/45">{name}</span>
  </div>

  <img
    src={`/products/${slug}.webp`}
    alt={name}
    loading={loading}
    decoding="async"
    sizes={sizes}
    class="relative z-10 max-h-full max-w-full w-auto h-auto object-contain rounded-2xl overflow-hidden transition-transform duration-500 will-change-transform group-hover:scale-[1.04]"
    onerror="this.style.display='none'"
  />
</div>
