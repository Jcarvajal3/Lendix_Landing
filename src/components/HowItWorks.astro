---
const steps = [
  {
    n: '01',
    title: 'Eliges tu producto',
    text: 'Entras al catalogo, escoges lo que necesitas y ves de una vez cuanto pagarias al mes. Sin letra pequena ni precios escondidos.',
    detail: 'Ejemplo: Nintendo Switch 2 por $32 al mes.',
  },
  {
    n: '02',
    title: 'Nos dices quien eres',
    text: 'Subes tu cedula, una selfie y un comprobante de residencia desde el telefono. Lo revisamos y te respondemos rapido.',
    detail: 'Tarda unos minutos, no dias.',
  },
  {
    n: '03',
    title: 'Recibes el producto en casa',
    text: 'Te lo llevamos a tu direccion. Lo desempacas y lo usas como si fuera tuyo, desde el primer dia.',
    detail: 'Envio incluido en tu renta.',
  },
  {
    n: '04',
    title: 'Pagas tu renta cada mes',
    text: 'Una cuota fija, siempre el mismo monto. Mientras pagues, el producto se queda contigo.',
    detail: 'Sin sorpresas al final del mes.',
  },
];

const endings = [
  {
    title: 'Te lo quedas mas tiempo',
    text: 'Sigues pagando tu renta mensual y listo. No tienes que hacer nada.',
    icon: 'keep',
  },
  {
    title: 'Lo cambias por otro',
    text: 'Salio un modelo nuevo o necesitas algo distinto? Cambias de equipo sin empezar de cero.',
    icon: 'swap',
  },
  {
    title: 'Lo devuelves y ya',
    text: 'Nos avisas, pasamos a buscarlo y dejas de pagar. Sin penalidad por terminar.',
    icon: 'return',
  },
];
---

<section id="como-funciona" class="scroll-mt-24 bg-cream py-20 sm:py-28">
  <div class="container-x">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Como funciona</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl">
        Cuatro pasos. <span class="text-flame-500">Nada mas.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Desde que eliges tu producto hasta que lo tienes encendido en tu casa.
      </p>
    </div>

    <ol class="reveal mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="relative flex h-full flex-col rounded-3xl border border-white/80 bg-white p-7 shadow-sm">
            <span class="font-display text-4xl font-bold text-flame-200">{step.n}</span>
            <h3 class="mt-4 font-display text-lg font-bold">{step.title}</h3>
            <p class="mt-2.5 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">{step.text}</p>
            <p class="mt-5 border-t border-hairline pt-4 text-[0.85rem] font-medium text-flame-600">{step.detail}</p>
          </li>
        ))
      }
    </ol>

    <!-- El punto clave: la salida -->
    <div class="reveal mt-6 overflow-hidden rounded-4xl bg-ink p-8 sm:p-12">
      <div class="max-w-3xl">
        <p class="eyebrow text-sun-400">Y aqui esta lo importante</p>
        <h3 class="mt-5 text-2xl leading-[1.15] font-bold text-white sm:text-4xl">
          En cualquier momento, <span class="text-sun-400">tu decides</span> que pasa con el producto.
        </h3>
        <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
          No estas amarrado a una deuda de dos anos. Cada mes es una decision tuya.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          endings.map((item) => (
            <div class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/10">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-sun-400 text-ink">
                {item.icon === 'keep' && (
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="m10 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 8.2l5-.7L10 3Z"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {item.icon === 'swap' && (
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M3 7h11m0 0-3-3m3 3-3 3M17 13H6m0 0 3-3m-3 3 3 3"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {item.icon === 'return' && (
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M4 10a6 6 0 1 0 1.8-4.3M4 4v3.5h3.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </span>
              <h4 class="mt-4 font-display text-base font-bold text-white">{item.title}</h4>
              <p class="mt-2 text-[0.925rem] leading-relaxed text-white/65">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
