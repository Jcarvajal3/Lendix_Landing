---
const steps = [
  {
    n: '01',
    title: 'Eliges tu producto',
    text: 'Entras al catalogo, escoges lo que necesitas y ves de una vez cuanto pagarias cada quincena. Sin letra pequeña ni precios escondidos.',
    detail: 'Ejemplo: Nintendo Switch 2 por $16 cada quincena.',
  },
  {
    n: '02',
    title: 'Nos dices quien eres',
    text: 'Subes tu cedula, una selfie y un comprobante de residencia desde el telefono. Lo revisamos y te respondemos rapido.',
    detail: 'Tarda unos minutos, no dias.',
  },
  {
    n: '03',
    title: 'Pagas tu renta cada quincena',
    text: 'Una cuota fija, siempre el mismo monto. Mientras pagues, el producto se queda contigo.',
    detail: 'Sin sorpresas al final de la quincena.',
  },
];
---

<section id="como-funciona" class="scroll-mt-24 bg-cream py-20 sm:py-28">
  <div class="container-x">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Como funciona</p>
      <h2 class="mt-5 text-3xl leading-[1.12] font-bold sm:text-5xl">
        Tres pasos. <span class="text-flame-500">Nada mas.</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ink-soft">
        Desde que eliges tu producto hasta que lo tienes encendido en tu casa.
      </p>
    </div>

    <ol class="reveal mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step) => (
          <li class="relative flex h-full flex-col rounded-3xl border border-white/80 bg-white p-7 shadow-sm">
            <span class="font-display text-4xl font-bold text-flame-200">{step.n}</span>
            <h3 class="mt-4 font-display text-lg font-bold">{step.title}</h3>
            <p class="mt-2.5 flex-1 text-base leading-relaxed text-ink-soft">{step.text}</p>
            <p class="mt-5 border-t border-hairline pt-4 text-[0.85rem] font-medium text-flame-600">{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

