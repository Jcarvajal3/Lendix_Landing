---
export const prerender = false;

---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Autenticando... | Lendix</title>
  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background-color: #FAF8F5;
      color: #1A1A1A;
    }
    .card {
      text-align: center;
      padding: 40px 32px;
      background: white;
      border-radius: 24px;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
      max-width: 360px;
      width: 90%;
    }
    .spinner {
      width: 44px;
      height: 44px;
      border: 3.5px solid #F3F4F6;
      border-top-color: #FF5A36;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    p {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 500;
      color: #4B5563;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="spinner"></div>
    <p id="status-text">Completando inicio de sesión...</p>
  </div>

  <script>
    // Se usa el MISMO cliente Supabase que arranco el login (el singleton de
    // lib/supabase), no una copia suelta desde un CDN. En PKCE, el navegador
    // guarda un `code_verifier` al pedir el login y hay que canjearlo con un
    // cliente que lea ese mismo storage: con dos clientes distintos (peor aun,
    // de versiones distintas) el canje falla y el usuario vuelve sin sesion.
    import { supabase, syncSessionToCookies } from '../../lib/supabase';

    const statusText = document.getElementById('status-text');
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');

    // Solo rutas internas: un `next` absoluto permitiria mandar al usuario
    // recien autenticado a un dominio ajeno.
    const rawNext = params.get('next') || '/completar-registro';
    const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/';

    /** Devuelve al inicio explicando que fallo, en vez de morir en silencio. */
    function fail(reason: string, detail?: unknown) {
      console.error('[auth/callback]', reason, detail ?? '');
      if (statusText) statusText.textContent = 'No pudimos completar el inicio de sesión. Regresando...';
      setTimeout(() => { window.location.href = `/?auth_error=${encodeURIComponent(reason)}`; }, 1800);
    }

    // Google puede devolver un error explicito (usuario cancelo, consent denegado).
    const oauthError = params.get('error_description') || params.get('error');

    if (oauthError) {
      fail(oauthError);
    } else if (!code) {
      // Sin code no hay nada que canjear: o ya habia sesion, o entraron a mano.
      window.location.href = next;
    } else {
      try {
        const { data, error } = await supabase.auth.exchangeCodeForSession(code);

        if (error) {
          fail(error.message, error);
        } else if (!data.session) {
          fail('sin_sesion');
        } else {
          // Cookies para que el middleware vea al usuario en el server.
          // Se escriben ANTES de navegar, asi la request a `next` ya las lleva.
          syncSessionToCookies(data.session.access_token, data.session.refresh_token);
          window.location.replace(next);
        }
      } catch (err) {
        fail('excepcion', err);
      }
    }
  </script>
</body>
</html>
