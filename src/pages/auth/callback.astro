---
export const prerender = false;

---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Autenticando... | Lendix</title>
  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background-color: #FAF8F5;
      color: #1A1A1A;
    }
    .card {
      text-align: center;
      padding: 40px 32px;
      background: white;
      border-radius: 24px;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
      max-width: 360px;
      width: 90%;
    }
    .spinner {
      width: 44px;
      height: 44px;
      border: 3.5px solid #F3F4F6;
      border-top-color: #FF5A36;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    p {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 500;
      color: #4B5563;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="spinner"></div>
    <p id="status-text">Completando inicio de sesión...</p>
  </div>

  <script>
    // Se usa el MISMO cliente Supabase que arranco el login (el singleton de
    // lib/supabase), no una copia suelta desde un CDN: en PKCE el navegador
    // guarda un `code_verifier` al pedir el login y solo un cliente que lea ese
    // mismo storage puede canjearlo.
    import { supabase, syncSessionToCookies } from '../../lib/supabase';

    const statusText = document.getElementById('status-text');
    const url = new URL(window.location.href);
    const query = url.searchParams;
    // En el flujo implicito Supabase responde en el fragmento, no en el query.
    const hash = new URLSearchParams(url.hash.replace(/^#/, ''));

    // Solo rutas internas: un `next` absoluto permitiria mandar al usuario
    // recien autenticado a un dominio ajeno.
    const rawNext = query.get('next') || '/completar-registro';
    const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/';

    /**
     * Obtiene la sesion aceptando las dos formas en que Supabase puede
     * responder. Hoy el cliente pide PKCE (caso A), pero el caso B se mantiene
     * a proposito: cubre a cualquiera que tenga un login a medias del flujo
     * anterior y evita que un cambio de configuracion vuelva a romper el login
     * en silencio.
     */
    async function resolveSession() {
      // A. PKCE — la respuesta viene como ?code= y se canjea con el verifier.
      const code = query.get('code');
      if (code) {
        const { data, error } = await supabase.auth.exchangeCodeForSession(code);
        if (error) throw error;
        return data.session;
      }

      // B. Implicito — los tokens vienen ya listos en el fragmento.
      const accessToken = hash.get('access_token');
      const refreshToken = hash.get('refresh_token');
      if (accessToken && refreshToken) {
        const { data, error } = await supabase.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken,
        });
        if (error) throw error;
        return data.session;
      }

      // C. Sin code ni tokens: quiza ya habia sesion y entraron a esta URL a mano.
      const { data } = await supabase.auth.getSession();
      return data.session;
    }

    /** Vuelve al inicio explicando que fallo, en vez de morir en silencio. */
    function fail(reason: string, detail?: unknown) {
      console.error('[auth/callback]', reason, detail ?? '');
      if (statusText) statusText.textContent = 'No pudimos completar el inicio de sesión. Regresando...';
      setTimeout(() => {
        window.location.replace(`/?auth_error=${encodeURIComponent(reason)}`);
      }, 1800);
    }

    // Google/Supabase pueden devolver un error explicito (usuario cancelo,
    // consentimiento denegado, redirect no permitido). Puede venir por
    // cualquiera de los dos canales.
    const oauthError =
      query.get('error_description') || hash.get('error_description') ||
      query.get('error') || hash.get('error');

    if (oauthError) {
      fail(oauthError);
    } else {
      try {
        const session = await resolveSession();

        if (!session) {
          fail('sin_sesion');
        } else {
          // Cookies para que el middleware vea al usuario en el server. Se
          // escriben ANTES de navegar, asi la request a `next` ya las lleva.
          syncSessionToCookies(session.access_token, session.refresh_token);
          // replace y no href: deja el callback fuera del historial, para que
          // el boton "atras" no reintente canjear un code ya consumido.
          window.location.replace(next);
        }
      } catch (err) {
        fail(err instanceof Error ? err.message : 'excepcion', err);
      }
    }
  </script>
</body>
</html>
