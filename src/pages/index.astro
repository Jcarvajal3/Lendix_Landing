---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Catalog from '../components/Catalog.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
import RentModal from '../components/RentModal.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
---

<Base>
  <Nav />

  <main id="contenido">
    <Hero />
    <Catalog />
    <HowItWorks />
    <Faq />
    <Waitlist />
  </main>

  <Footer />

  {/* Modales globales (posicionados con fixed, fuera del flujo) */}
  <RentModal />
  <WaitlistModal />
</Base>
