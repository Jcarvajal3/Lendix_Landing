---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase-admin';

// Check auth and role
const userProfile = Astro.locals.userProfile;
if (!userProfile || (userProfile.role !== 'admin' && userProfile.role !== 'superadmin')) {
  return Astro.redirect('/login');
}

// Fetch all payments
const { data: paymentsData, error: paymentsError } = await supabaseAdmin
  .from('rental_payments')
  .select('*')
  .order('due_date', { ascending: true });

const payments = paymentsData || [];

// Fetch user profiles to map names
const { data: usersData } = await supabaseAdmin
  .from('user_profiles')
  .select('id, full_name');
const userMap = new Map((usersData || []).map(u => [u.id, u.full_name]));

// Fetch rental applications to map product names
const { data: rentalsData } = await supabaseAdmin
  .from('rental_applications')
  .select('id, product_name');
const rentalMap = new Map((rentalsData || []).map(r => [r.id, r.product_name]));

// Process payments to include names
const processedPayments = payments.map(p => ({
  ...p,
  client_name: userMap.get(p.user_id) || 'Cliente Desconocido',
  product_name: rentalMap.get(p.rental_id) || 'Producto Desconocido'
}));

// Calculate totals
const totalPending = processedPayments
  .filter(p => p.status === 'pending')
  .reduce((sum, p) => sum + Number(p.amount), 0);

const totalPaid = processedPayments
  .filter(p => p.status === 'paid')
  .reduce((sum, p) => sum + Number(p.amount), 0);

const totalOverdue = processedPayments
  .filter(p => p.status === 'overdue')
  .reduce((sum, p) => sum + Number(p.amount), 0);

// Format currency
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD' 
  }).format(amount);
};

// Format date
const formatDate = (dateStr: string) => {
  if (!dateStr) return 'N/A';
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(new Date(dateStr));
};
---

<AdminLayout title="Pagos" activePage="pagos">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-display font-bold text-ink mb-1">Gestión de Pagos</h1>
      <p class="text-ink/70">Control y seguimiento de cuotas de renta</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col">
      <span class="text-sm font-medium text-ink/60 mb-2">Total por Cobrar</span>
      <span class="text-3xl font-display font-bold text-flame-500">{formatCurrency(totalPending)}</span>
    </div>
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col">
      <span class="text-sm font-medium text-ink/60 mb-2">Total Cobrado</span>
      <span class="text-3xl font-display font-bold text-green-600">{formatCurrency(totalPaid)}</span>
    </div>
    <div class="kpi-card bg-white p-6 rounded-xl border border-red-500/30 bg-red-50/50 shadow-sm flex flex-col">
      <span class="text-sm font-medium text-red-600 mb-2">Total Vencido</span>
      <span class="text-3xl font-display font-bold text-red-600">{formatCurrency(totalOverdue)}</span>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white p-4 rounded-xl border border-ink/10 mb-6 flex flex-col sm:flex-row gap-4 shadow-sm">
    <div class="flex-1">
      <label for="searchInput" class="sr-only">Buscar</label>
      <input 
        type="text" 
        id="searchInput" 
        placeholder="Buscar por cliente o producto..." 
        class="w-full px-4 py-2 border border-ink/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-flame-500"
      />
    </div>
    <div class="sm:w-64">
      <label for="statusFilter" class="sr-only">Estado</label>
      <select 
        id="statusFilter" 
        class="w-full px-4 py-2 border border-ink/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-flame-500 bg-white"
      >
        <option value="all">Todos los estados</option>
        <option value="pending">Pendientes</option>
        <option value="paid">Pagados</option>
        <option value="overdue">Vencidos</option>
      </select>
    </div>
  </div>

  <!-- Table -->
  <div class="admin-table-container bg-white rounded-xl border border-ink/10 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="admin-table w-full text-left border-collapse">
        <thead>
          <tr class="bg-ink/5 border-b border-ink/10">
            <th class="px-6 py-4 text-sm font-semibold text-ink">ID</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink">Cliente</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink">Producto</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink text-center">Cuota #</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink">Monto</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink">Vencimiento</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink">Estado</th>
            <th class="px-6 py-4 text-sm font-semibold text-ink text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="paymentsTableBody">
          {processedPayments.length === 0 ? (
            <tr>
              <td colspan="8" class="px-6 py-8 text-center text-ink/50">
                No hay pagos registrados
              </td>
            </tr>
          ) : (
            processedPayments.map((payment) => (
              <tr 
                class={`border-b border-ink/5 hover:bg-ink/5 transition-colors payment-row ${payment.status === 'overdue' ? 'bg-red-50/30' : ''}`}
                data-id={payment.id}
                data-client={payment.client_name.toLowerCase()}
                data-product={payment.product_name.toLowerCase()}
                data-status={payment.status}
              >
                <td class="px-6 py-4 text-sm font-medium text-ink/70">
                  {payment.id.substring(0, 8)}
                </td>
                <td class="px-6 py-4 text-sm text-ink font-medium">
                  {payment.client_name}
                </td>
                <td class="px-6 py-4 text-sm text-ink/80">
                  {payment.product_name}
                </td>
                <td class="px-6 py-4 text-sm text-ink/80 text-center">
                  {payment.installment_number}
                </td>
                <td class="px-6 py-4 text-sm font-medium text-ink">
                  {formatCurrency(payment.amount)}
                </td>
                <td class="px-6 py-4 text-sm text-ink/80">
                  {formatDate(payment.due_date)}
                </td>
                <td class="px-6 py-4">
                  <span class={`px-2.5 py-1 rounded-full text-xs font-medium status-badge badge-${payment.status}`}>
                    {payment.status === 'pending' ? 'Pendiente' : 
                     payment.status === 'paid' ? 'Pagado' : 
                     payment.status === 'overdue' ? 'Vencido' : payment.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  {(payment.status === 'pending' || payment.status === 'overdue') ? (
                    <button
                      type="button"
                      class="mark-paid-btn inline-flex items-center px-3 py-1.5 text-xs font-medium bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shadow-sm"
                      data-payment-id={payment.id}
                    >
                      Marcar pagado
                    </button>
                  ) : (
                    <span class="text-xs text-ink/40 italic">-</span>
                  )}
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const rows = document.querySelectorAll('.payment-row');

    function filterTable() {
      const searchTerm = searchInput.value.toLowerCase();
      const statusValue = statusFilter.value;

      rows.forEach((row) => {
        const client = row.getAttribute('data-client') || '';
        const product = row.getAttribute('data-product') || '';
        const status = row.getAttribute('data-status') || '';

        const matchesSearch = client.includes(searchTerm) || product.includes(searchTerm);
        const matchesStatus = statusValue === 'all' || status === statusValue;

        if (matchesSearch && matchesStatus) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // Handle Mark Paid actions
    const markPaidButtons = document.querySelectorAll('.mark-paid-btn');
    markPaidButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const paymentId = button.getAttribute('data-payment-id');
        
        if (!paymentId) return;

        if (!confirm('¿Estás seguro de marcar esta cuota como pagada?')) {
          return;
        }

        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Procesando...';

        try {
          const response = await fetch('/api/admin/update-payment-status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id: paymentId, status: 'paid' }),
          });

          if (!response.ok) {
            throw new Error('Error al actualizar el pago');
          }

          // Update UI on success
          const row = button.closest('tr');
          if (row) {
            // Update row attributes
            row.setAttribute('data-status', 'paid');
            row.classList.remove('bg-red-50/30');

            // Update badge
            const badge = row.querySelector('.status-badge');
            if (badge) {
              badge.className = 'px-2.5 py-1 rounded-full text-xs font-medium status-badge badge-paid';
              badge.textContent = 'Pagado';
            }

            // Replace button with dash
            const actionsCell = button.closest('td');
            if (actionsCell) {
              actionsCell.innerHTML = '<span class="text-xs text-ink/40 italic">-</span>';
            }
          }
          
        } catch (error) {
          console.error('Error:', error);
          alert('Hubo un error al actualizar el pago. Por favor intenta nuevamente.');
          button.disabled = false;
          button.textContent = originalText;
        }
      });
    });
  });
</script>
