---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboardMetrics } from '../../lib/supabase-admin';

// userProfile is guaranteed by middleware (redirects non-admin before HTML)
const userProfile = Astro.locals.userProfile;

// Fetch metrics
let metrics;
try {
  metrics = await getDashboardMetrics();
} catch (error) {
  console.error("Error fetching dashboard metrics:", error);
  // Fallback to empty metrics if there's an error
  metrics = {};
}

// Destructure with default values in case data is missing
const {
  revenueThisMonth = 0,
  revenueLastMonth = 0,
  revenueChange = 0,
  activeRentals = 0,
  totalUsers = 0,
  pendingPayments = 0,
  overduePayments = 0,
  totalLeads = 0,
  monthlyRevenue = [],
  recentRentals = []
} = metrics || {};

const maxRevenue = Math.max(...monthlyRevenue.map((m: any) => m.amount || 0), 1);

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
  }).format(amount || 0);
}

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Intl.DateTimeFormat('es-MX', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(new Date(dateStr));
}

function getStatusBadgeClass(status: string) {
  switch(status?.toLowerCase()) {
    case 'pending': return 'badge-pending';
    case 'reviewing': return 'badge-pending';
    case 'approved': return 'badge-approved';
    case 'rejected': return 'badge-rejected';
    case 'cancelled': return 'badge-cancelled';
    default: return 'badge-pending';
  }
}

function translateStatus(status: string) {
  switch(status?.toLowerCase()) {
    case 'pending': return 'Pendiente';
    case 'reviewing': return 'En Revisión';
    case 'approved': return 'Aprobado';
    case 'rejected': return 'Rechazado';
    case 'cancelled': return 'Cancelado';
    default: return status || 'Desconocido';
  }
}
---

<AdminLayout title="Dashboard" activePage="dashboard">
  <div class="mb-8 admin-animate-in" style="--delay: 0ms">
    <h1 class="text-3xl font-display font-bold text-ink mb-2">Buen día, {userProfile.full_name}</h1>
    <p class="text-ink/70">Aquí está el resumen del estado del negocio.</p>
  </div>

  <div class="kpi-grid mb-10 admin-animate-in grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" style="--delay: 100ms">
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col justify-between">
      <h3 class="text-sm font-medium text-ink/60 mb-2">Ingresos del mes</h3>
      <div class="flex items-end justify-between">
        <p class="text-3xl font-bold text-ink">{formatCurrency(revenueThisMonth)}</p>
        {revenueChange !== 0 && (
          <span class={`text-sm font-medium flex items-center ${revenueChange > 0 ? 'text-green-600' : 'text-red-600'}`}>
            {revenueChange > 0 ? '↑' : '↓'} {Math.abs(revenueChange)}%
          </span>
        )}
      </div>
    </div>
    
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col justify-between">
      <h3 class="text-sm font-medium text-ink/60 mb-2">Rentas activas</h3>
      <p class="text-3xl font-bold text-ink">{activeRentals}</p>
    </div>
    
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col justify-between">
      <h3 class="text-sm font-medium text-ink/60 mb-2">Usuarios registrados</h3>
      <p class="text-3xl font-bold text-ink">{totalUsers}</p>
    </div>
    
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col justify-between">
      <h3 class="text-sm font-medium text-ink/60 mb-2">Pagos pendientes</h3>
      <p class="text-3xl font-bold text-ink">{pendingPayments}</p>
    </div>
    
    <div class={`kpi-card p-6 rounded-xl border shadow-sm flex flex-col justify-between ${overduePayments > 0 ? 'border-red-500 bg-red-50' : 'bg-white border-ink/10'}`}>
      <h3 class={`text-sm font-medium mb-2 ${overduePayments > 0 ? 'text-red-700' : 'text-ink/60'}`}>Pagos vencidos</h3>
      <p class={`text-3xl font-bold ${overduePayments > 0 ? 'text-red-600' : 'text-ink'}`}>{overduePayments}</p>
    </div>
    
    <div class="kpi-card bg-white p-6 rounded-xl border border-ink/10 shadow-sm flex flex-col justify-between">
      <h3 class="text-sm font-medium text-ink/60 mb-2">Leads totales</h3>
      <p class="text-3xl font-bold text-ink">{totalLeads}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10 admin-animate-in" style="--delay: 200ms">
    <div class="lg:col-span-2 chart-container p-6 bg-white rounded-xl border border-ink/10 shadow-sm">
      <h2 class="text-lg font-display font-semibold text-ink mb-6">Ingresos últimos 6 meses</h2>
      <div class="bar-chart h-64 flex items-end justify-between gap-4">
        {monthlyRevenue.length > 0 ? (
          monthlyRevenue.map((item: any) => {
            const heightPercent = Math.max(((item.amount || 0) / maxRevenue) * 100, 5);
            return (
              <div class="bar-chart-col flex flex-col items-center justify-end flex-1 h-full gap-2 group relative">
                <div class="absolute -top-8 bg-ink text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10 shadow-md">
                  {formatCurrency(item.amount)}
                </div>
                <div
                  class="bar-chart-bar w-full max-w-[4rem] bg-flame-500 rounded-t-md transition-all duration-300 hover:bg-flame-400 cursor-pointer"
                  style={`height: ${heightPercent}%`}
                  data-value={formatCurrency(item.amount)}
                ></div>
                <span class="text-xs text-ink/60 font-medium mt-2">{item.month}</span>
              </div>
            );
          })
        ) : (
          <div class="w-full h-full flex items-center justify-center text-ink/50 text-sm">No hay datos suficientes para mostrar</div>
        )}
      </div>
    </div>
    
    <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-6 flex flex-col justify-center items-center text-center">
      <div class="w-16 h-16 bg-cream rounded-full flex items-center justify-center text-flame-500 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <h3 class="text-xl font-display font-bold text-ink mb-2">Salud del Negocio</h3>
      <p class="text-ink/70 text-sm max-w-[200px]">
        {overduePayments > 0 
          ? `Atención requerida: Tienes ${overduePayments} ${overduePayments === 1 ? 'pago vencido que necesita' : 'pagos vencidos que necesitan'} seguimiento.`
          : 'Todo en orden. No hay pagos vencidos actualmente.'}
      </p>
    </div>
  </div>

  <div class="admin-table-container bg-white rounded-xl border border-ink/10 shadow-sm overflow-hidden admin-animate-in" style="--delay: 300ms">
    <div class="flex items-center justify-between p-6 border-b border-ink/10">
      <h2 class="text-lg font-display font-semibold text-ink">Solicitudes Recientes</h2>
      <a href="/admin/rentas" class="text-sm text-flame-500 hover:text-flame-600 font-medium inline-flex items-center gap-1">
        Ver todas
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
    
    <div class="overflow-x-auto">
      <table class="admin-table w-full text-left border-collapse">
        <thead>
          <tr class="bg-cream/30 border-b border-ink/10">
            <th class="py-4 px-6 text-xs font-semibold text-ink/50 uppercase tracking-wider">ID</th>
            <th class="py-4 px-6 text-xs font-semibold text-ink/50 uppercase tracking-wider">Producto</th>
            <th class="py-4 px-6 text-xs font-semibold text-ink/50 uppercase tracking-wider">Estado</th>
            <th class="py-4 px-6 text-xs font-semibold text-ink/50 uppercase tracking-wider">Fecha</th>
            <th class="py-4 px-6 text-xs font-semibold text-ink/50 uppercase tracking-wider text-right">Monto/mes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink/5">
          {recentRentals.length > 0 ? (
            recentRentals.map((app: any) => (
              <tr class="hover:bg-cream/10 transition-colors group">
                <td class="py-4 px-6 text-sm font-mono text-ink/60">
                  #{app.id}
                </td>
                <td class="py-4 px-6 text-sm font-medium text-ink">{app.product_name || '---'}</td>
                <td class="py-4 px-6">
                  <span class={`px-2.5 py-1 rounded-full text-xs font-medium border ${getStatusBadgeClass(app.status)}`}>
                    {translateStatus(app.status)}
                  </span>
                </td>
                <td class="py-4 px-6 text-sm text-ink/70">{formatDate(app.created_at)}</td>
                <td class="py-4 px-6 text-sm text-ink font-semibold text-right">{formatCurrency(app.monthly_rent)}</td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="5" class="py-12 text-center text-sm text-ink/50">
                <div class="flex flex-col items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-ink/20 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                  No hay solicitudes recientes
                </div>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
