---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase-admin';

// Fetch all rental applications
const { data: rentals, error: rentalsError } = await supabaseAdmin
  .from('rental_applications')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch user profiles to join
const { data: users, error: usersError } = await supabaseAdmin
  .from('user_profiles')
  .select('*');

// Build a map of user_id to user_profile
const userMap = new Map();
if (users) {
  users.forEach(u => userMap.set(u.id, u));
}

// Combine data
const rentalData = (rentals || []).map(r => ({
  ...r,
  user: userMap.get(r.user_id) || {}
}));

const total = rentalData.length;
const pending = rentalData.filter(r => r.status === 'pending' || r.status === 'reviewing').length;
const approved = rentalData.filter(r => r.status === 'approved').length;
const rejected = rentalData.filter(r => r.status === 'rejected' || r.status === 'cancelled').length;

// For formatting dates
function formatDate(dateStr: string) {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('es-CO', {
    year: 'numeric', month: 'short', day: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
}

function getStatusBadgeClass(status: string) {
  switch(status) {
    case 'pending': return 'badge-pending';
    case 'reviewing': return 'badge-pending';
    case 'approved': return 'badge-approved';
    case 'rejected': return 'badge-rejected';
    case 'cancelled': return 'badge-cancelled';
    default: return 'badge-pending';
  }
}

function getStatusLabel(status: string) {
  switch(status) {
    case 'pending': return 'Pendiente';
    case 'reviewing': return 'En Revisión';
    case 'approved': return 'Aprobado';
    case 'rejected': return 'Rechazado';
    case 'cancelled': return 'Cancelado';
    default: return status;
  }
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const accessToken = Astro.cookies.get('sb-access-token')?.value || '';
---
<AdminLayout title="Gestión de Rentas" activePage="rentas">
    <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <h1 class="text-2xl font-display font-bold text-ink">Gestión de Rentas</h1>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="kpi-card bg-white p-4 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-sm font-medium text-gray-500 mb-1">Total Rentas</h3>
            <p class="text-3xl font-display font-bold text-ink">{total}</p>
        </div>
        <div class="kpi-card bg-white p-4 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-sm font-medium text-gray-500 mb-1">Pendientes</h3>
            <p class="text-3xl font-display font-bold text-flame-500">{pending}</p>
        </div>
        <div class="kpi-card bg-white p-4 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-sm font-medium text-gray-500 mb-1">Aprobadas</h3>
            <p class="text-3xl font-display font-bold text-green-600">{approved}</p>
        </div>
        <div class="kpi-card bg-white p-4 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-sm font-medium text-gray-500 mb-1">Rechazadas</h3>
            <p class="text-3xl font-display font-bold text-red-600">{rejected}</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6 flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div class="w-full sm:w-1/3">
            <label for="searchInput" class="sr-only">Buscar</label>
            <input type="text" id="searchInput" placeholder="Buscar por producto o cliente..." class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-flame-500" />
        </div>
        <div class="w-full sm:w-auto">
            <select id="statusFilter" class="w-full sm:w-48 px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-flame-500 bg-white text-gray-700">
                <option value="all">Todos los estados</option>
                <option value="pending">Pendientes</option>
                <option value="reviewing">En Revisión</option>
                <option value="approved">Aprobados</option>
                <option value="rejected">Rechazados</option>
                <option value="cancelled">Cancelados</option>
            </select>
        </div>
    </div>

    <!-- Table -->
    <div class="admin-table-container overflow-x-auto bg-white rounded-xl shadow-sm border border-gray-100">
        <table class="admin-table w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-sm font-medium text-gray-500">
                    <th class="py-3 px-4 whitespace-nowrap">ID</th>
                    <th class="py-3 px-4 whitespace-nowrap">Cliente</th>
                    <th class="py-3 px-4 whitespace-nowrap">Producto</th>
                    <th class="py-3 px-4 whitespace-nowrap">Plan</th>
                    <th class="py-3 px-4 whitespace-nowrap">Monto/mes</th>
                    <th class="py-3 px-4 whitespace-nowrap">Estado</th>
                    <th class="py-3 px-4 whitespace-nowrap">Fecha Solicitud</th>
                    <th class="py-3 px-4 text-right whitespace-nowrap">Acciones</th>
                </tr>
            </thead>
            <tbody id="rentalsTableBody">
                {rentalData.map(rental => (
                    <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors rental-row" 
                        data-status={rental.status} 
                        data-product={rental.product_name?.toLowerCase()}
                        data-client={rental.user?.full_name?.toLowerCase()}
                        data-email={rental.user?.email?.toLowerCase()}
                        data-id={rental.id}
                        data-rental={JSON.stringify(rental, (_key, value) => typeof value === 'bigint' ? String(value) : value)}>
                        <td class="py-3 px-4 font-mono text-xs text-gray-500" title={String(rental.id)}>
                            #{rental.id}
                        </td>
                        <td class="py-3 px-4">
                            <div class="font-medium text-ink">{rental.user?.full_name || 'Desconocido'}</div>
                            <div class="text-xs text-gray-500">{rental.user?.email || ''}</div>
                        </td>
                        <td class="py-3 px-4 text-ink font-medium text-sm">
                            {rental.product_name}
                        </td>
                        <td class="py-3 px-4 text-gray-600 text-sm">
                            {rental.term_months} meses
                        </td>
                        <td class="py-3 px-4 text-ink font-medium text-sm">
                            ${(rental.monthly_rent || 0).toLocaleString('es-CO')}
                        </td>
                        <td class="py-3 px-4">
                            <span class={`px-2 py-1 rounded-full text-xs font-medium status-badge ${getStatusBadgeClass(rental.status)}`}>
                                {getStatusLabel(rental.status)}
                            </span>
                        </td>
                        <td class="py-3 px-4 text-sm text-gray-500 whitespace-nowrap">
                            {formatDate(rental.created_at)}
                        </td>
                        <td class="py-3 px-4 text-right">
                            <div class="flex justify-end gap-2 items-center">
                                {['pending', 'reviewing'].includes(rental.status) && (
                                    <>
                                        <button class="action-approve px-3 py-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-medium rounded transition-colors" data-id={rental.id}>
                                            Aprobar
                                        </button>
                                        <button class="action-reject px-3 py-1.5 border border-red-500 text-red-500 hover:bg-red-50 text-xs font-medium rounded transition-colors" data-id={rental.id}>
                                            Rechazar
                                        </button>
                                    </>
                                )}
                                <button class="action-details px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-ink text-xs font-medium rounded transition-colors" data-id={rental.id}>
                                    Ver detalles
                                </button>
                            </div>
                        </td>
                    </tr>
                ))}
                {rentalData.length === 0 && (
                    <tr>
                        <td colspan="8" class="py-8 text-center text-gray-500">
                            No hay rentas registradas.
                        </td>
                    </tr>
                )}
            </tbody>
        </table>
    </div>

    <!-- Details Modal -->
    <div id="detailsModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h2 class="text-xl font-display font-bold text-ink">Detalles de la Solicitud</h2>
                <button id="closeDetailsModal" class="text-gray-400 hover:text-ink transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-6 overflow-y-auto" id="modalContent">
                <!-- Content injected via JS -->
            </div>
            <div class="p-6 border-t border-gray-100 bg-gray-50 flex justify-end gap-3" id="modalActions">
                <button id="closeModalBtn" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-100 font-medium transition-colors">Cerrar</button>
                <!-- Actions injected via JS if pending -->
            </div>
        </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ supabaseUrl, accessToken }}>
    // DOM Elements
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const rows = document.querySelectorAll('.rental-row');
    
    const detailsModal = document.getElementById('detailsModal');
    const modalContent = document.getElementById('modalContent');
    const modalActions = document.getElementById('modalActions');
    const closeDetailsModal = document.getElementById('closeDetailsModal');
    const closeModalBtn = document.getElementById('closeModalBtn');

    // Filtering logic
    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const statusValue = statusFilter.value;

        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            const product = row.getAttribute('data-product') || '';
            const client = row.getAttribute('data-client') || '';
            const email = row.getAttribute('data-email') || '';
            
            const matchStatus = statusValue === 'all' || status === statusValue;
            const matchSearch = product.includes(searchTerm) || client.includes(searchTerm) || email.includes(searchTerm);

            if (matchStatus && matchSearch) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // Action handlers
    async function handleStatusUpdate(id, newStatus) {
        const actionName = newStatus === 'approved' ? 'aprobar' : 'rechazar';
        if (!confirm(`¿Estás seguro de que deseas ${actionName} esta solicitud?`)) {
            return;
        }

        try {
            const res = await fetch('/api/admin/update-rental-status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ id, status: newStatus })
            });

            if (!res.ok) throw new Error('Error en la API');
            
            // Update UI
            const row = document.querySelector(`.rental-row[data-id="${id}"]`);
            if (row) {
                row.setAttribute('data-status', newStatus);
                
                // Update badge
                const badge = row.querySelector('.status-badge');
                if (badge) {
                    badge.className = `px-2 py-1 rounded-full text-xs font-medium status-badge ${getStatusClass(newStatus)}`;
                    badge.textContent = getStatusText(newStatus);
                }

                // Hide action buttons
                const approveBtn = row.querySelector('.action-approve');
                const rejectBtn = row.querySelector('.action-reject');
                if (approveBtn) approveBtn.style.display = 'none';
                if (rejectBtn) rejectBtn.style.display = 'none';
                
                // Update data attribute for modal
                const data = JSON.parse(row.getAttribute('data-rental') || '{}');
                data.status = newStatus;
                row.setAttribute('data-rental', JSON.stringify(data));
            }
            
            // Close modal if open
            closeModal();
            alert(`Solicitud ${newStatus === 'approved' ? 'aprobada' : 'rechazada'} exitosamente.`);
        } catch (err) {
            console.error(err);
            alert('Hubo un error al actualizar la solicitud.');
        }
    }

    function getStatusClass(status) {
        switch(status) {
            case 'pending': return 'badge-pending';
            case 'reviewing': return 'badge-pending';
            case 'approved': return 'badge-approved';
            case 'rejected': return 'badge-rejected';
            case 'cancelled': return 'badge-cancelled';
            default: return 'badge-pending';
        }
    }

    function getStatusText(status) {
        switch(status) {
            case 'pending': return 'Pendiente';
            case 'reviewing': return 'En Revisión';
            case 'approved': return 'Aprobado';
            case 'rejected': return 'Rechazado';
            case 'cancelled': return 'Cancelado';
            default: return status;
        }
    }

    // Attach events to dynamic buttons in table
    document.addEventListener('click', (e) => {
        const approveBtn = e.target.closest('.action-approve');
        const rejectBtn = e.target.closest('.action-reject');
        const detailsBtn = e.target.closest('.action-details');
        
        if (approveBtn) {
            const id = approveBtn.getAttribute('data-id');
            window.handleStatusUpdateWrapper(id, 'approved');
        } else if (rejectBtn) {
            const id = rejectBtn.getAttribute('data-id');
            window.handleStatusUpdateWrapper(id, 'rejected');
        } else if (detailsBtn) {
            const id = detailsBtn.getAttribute('data-id');
            const row = document.querySelector(`.rental-row[data-id="${id}"]`);
            if(row) {
                const data = JSON.parse(row.getAttribute('data-rental') || '{}');
                openDetailsModal(data);
            }
        }
    });
    
    // Expose wrapper to global scope so inline onclick handles work
    window.handleStatusUpdateWrapper = handleStatusUpdate;
    window.closeModalWrapper = closeModal;

    function openDetailsModal(rental) {
        const u = rental.user || {};
        
        // Ensure URLs are absolute for supabase storage
        const storagePrefix = `${supabaseUrl}/storage/v1/object/public/`;
        let cedulaFront = null;
        let cedulaBack = null;
        let selfie = null;
        
        if (rental.cedula_front_path) {
             cedulaFront = rental.cedula_front_path.startsWith('http') ? rental.cedula_front_path : storagePrefix + rental.cedula_front_path;
        }
        if (rental.cedula_back_path) {
             cedulaBack = rental.cedula_back_path.startsWith('http') ? rental.cedula_back_path : storagePrefix + rental.cedula_back_path;
        }
        if (rental.selfie_path) {
             selfie = rental.selfie_path.startsWith('http') ? rental.selfie_path : storagePrefix + rental.selfie_path;
        }

        if (modalContent) {
            modalContent.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- User Info -->
                    <div>
                        <h3 class="text-sm font-display font-bold text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Información del Cliente</h3>
                        <div class="space-y-4">
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Nombre Completo</span>
                                <span class="font-medium text-ink">${u.full_name || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Email</span>
                                <span class="font-medium text-ink">${u.email || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Teléfono (Perfil)</span>
                                <span class="font-medium text-ink">${u.phone || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Cédula</span>
                                <span class="font-medium text-ink">${u.cedula || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Dirección</span>
                                <span class="font-medium text-ink text-sm">${u.address || 'N/A'}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Rental Info -->
                    <div>
                        <h3 class="text-sm font-display font-bold text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Detalles de Solicitud</h3>
                        <div class="space-y-4">
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Producto</span>
                                <span class="font-medium text-ink">${rental.product_name || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Plan</span>
                                <span class="font-medium text-ink">${rental.term_months || 0} meses</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Monto Mensual</span>
                                <span class="font-medium text-ink">$${(rental.monthly_rent || 0).toLocaleString('es-CO')}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Teléfono de Contacto</span>
                                <span class="font-medium text-ink">${rental.phone || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium">Dirección de Entrega</span>
                                <span class="font-medium text-ink text-sm">${rental.address || 'N/A'}, ${rental.city || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium mb-1">Estado Actual</span>
                                <span class="px-2 py-1 rounded-full text-xs font-medium status-badge ${getStatusClass(rental.status)}">${getStatusText(rental.status)}</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- KYC Documents -->
                <div class="mt-8">
                    <h3 class="text-sm font-display font-bold text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Documentos KYC</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        ${cedulaFront ? `
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium mb-2">Cédula Frontal</span>
                                <a href="${cedulaFront}" target="_blank" class="block rounded-lg overflow-hidden border border-gray-200 hover:border-flame-500 transition-colors shadow-sm">
                                    <img src="${cedulaFront}" alt="Cédula Frontal" class="w-full h-40 object-cover" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' fill=\\'none\\' viewBox=\\'0 0 24 24\\' stroke=\\'%23ccc\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\\'/></svg>'" />
                                </a>
                            </div>
                        ` : '<div class="text-sm text-gray-400 flex items-center justify-center bg-gray-50 h-40 rounded-lg border border-gray-100">Sin cédula frontal</div>'}
                        ${cedulaBack ? `
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium mb-2">Cédula Trasera</span>
                                <a href="${cedulaBack}" target="_blank" class="block rounded-lg overflow-hidden border border-gray-200 hover:border-flame-500 transition-colors shadow-sm">
                                    <img src="${cedulaBack}" alt="Cédula Trasera" class="w-full h-40 object-cover" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' fill=\\'none\\' viewBox=\\'0 0 24 24\\' stroke=\\'%23ccc\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\\'/></svg>'" />
                                </a>
                            </div>
                        ` : '<div class="text-sm text-gray-400 flex items-center justify-center bg-gray-50 h-40 rounded-lg border border-gray-100">Sin cédula trasera</div>'}
                        ${selfie ? `
                            <div>
                                <span class="text-xs text-gray-400 block uppercase font-medium mb-2">Selfie</span>
                                <a href="${selfie}" target="_blank" class="block rounded-lg overflow-hidden border border-gray-200 hover:border-flame-500 transition-colors shadow-sm">
                                    <img src="${selfie}" alt="Selfie" class="w-full h-40 object-cover" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' fill=\\'none\\' viewBox=\\'0 0 24 24\\' stroke=\\'%23ccc\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\\'/></svg>'" />
                                </a>
                            </div>
                        ` : '<div class="text-sm text-gray-400 flex items-center justify-center bg-gray-50 h-40 rounded-lg border border-gray-100">Sin selfie</div>'}
                    </div>
                </div>

                <!-- Notes -->
                <div class="mt-8 mb-4">
                    <h3 class="text-sm font-display font-bold text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Notas Administrativas</h3>
                    <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 text-sm text-gray-700 whitespace-pre-wrap min-h-[4rem]">${rental.notes || 'No hay notas registradas para esta solicitud.'}</div>
                </div>
            `;
        }

        // Update modal actions based on status
        if (modalActions) {
            const actions = [];
            actions.push(`<button type="button" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-100 font-medium transition-colors" onclick="window.closeModalWrapper()">Cerrar</button>`);
            
            if (['pending', 'reviewing'].includes(rental.status)) {
                actions.unshift(`<button type="button" class="px-5 py-2 border border-red-500 text-red-500 hover:bg-red-50 rounded-lg font-medium transition-colors" onclick="window.handleStatusUpdateWrapper('${rental.id}', 'rejected')">Rechazar Solicitud</button>`);
                actions.unshift(`<button type="button" class="px-5 py-2 bg-green-500 text-white hover:bg-green-600 rounded-lg font-medium transition-colors shadow-sm" onclick="window.handleStatusUpdateWrapper('${rental.id}', 'approved')">Aprobar Solicitud</button>`);
            }
            
            modalActions.innerHTML = actions.join('');
        }
        
        if (detailsModal) {
            detailsModal.classList.remove('hidden');
        }
    }

    function closeModal() {
        if (detailsModal) {
            detailsModal.classList.add('hidden');
        }
    }

    if (closeDetailsModal) closeDetailsModal.addEventListener('click', closeModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    
    // Close on backdrop click
    if (detailsModal) {
        detailsModal.addEventListener('click', (e) => {
            if (e.target === detailsModal) {
                closeModal();
            }
        });
    }
</script>
