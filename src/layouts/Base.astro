---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lendix — Renta tecnologia y electrodomesticos por quincena. Devuelve cuando quieras.',
  description =
    'Usa el Nintendo Switch 2, un MacBook, una laptop de trabajo, un lavavajillas o un televisor pagando una renta quincenal. Sin comprarlo, sin deudas eternas y con la libertad de devolverlo cuando quieras.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://lendix.vercel.app');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FF6B2C" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lendix" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', canonical)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!--
      Activa el estado oculto de las animaciones ANTES del primer pintado, y solo
      si este navegador puede revelarlas despues. Sin esto (JS desactivado, script
      bloqueado, crawler simple), `.reveal` se queda visible: la landing nunca
      aparece en blanco.
    -->
    <script is:inline>
      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Lendix',
        url: canonical.origin,
        description: description,
        areaServed: 'VE',
      })}
    />
  </head>

  <body class="bg-white antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>

    <slot />

    <script is:inline>
      // Aparicion progresiva de secciones al hacer scroll.
      (function () {
        const items = document.querySelectorAll('.reveal');
        if (!items.length) return;

        const revealAll = () => items.forEach((el) => el.classList.add('is-visible'));

        if (!document.documentElement.classList.contains('reveal-ready')) {
          revealAll();
          return;
        }

        // Red de seguridad: si a los 2s el observer no ha revelado NADA, esta
        // roto. Mostramos todo de golpe antes que dejar la pagina en blanco.
        let fired = false;
        const safety = setTimeout(() => {
          if (!fired) revealAll();
        }, 2000);

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              fired = true;
              clearTimeout(safety);
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );

        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
